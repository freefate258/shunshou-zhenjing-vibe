{
  "name": "shunshou-zhenjing-vibe",
  "version": "1.0.1",
  "private": true,
  "description": "顺手真经vibe Android 安装包",
  "scripts": {
    "assets": "node scripts/generate-icons.mjs",
    "build:web": "esbuild src/native-tts.js --bundle --minify --format=iife --target=chrome80 --outfile=dist/native-tts.js",
    "android:sync": "npm run build:web && cap sync android",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2"
  }
}
